# These are local-dev defaults, used by `docker compose up` and by running the
# backend/frontend dev servers directly. The deployed instances (see README "Live
# demo") are configured separately in the Render and Vercel dashboards, not from
# this file - see README "Deployment" for the exact production values.

# Backend (backend/app/config.py)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEFAULT_CONFIDENCE=0.9

# Frontend build arg / runtime env (frontend/src/api/client.ts)
VITE_API_BASE_URL=http://localhost:8000
